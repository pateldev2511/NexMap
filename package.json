{
  "name": "nexmap",
  "version": "0.6.2",
  "private": true,
  "description": "Local-first browser app for designing and validating network infrastructure diagrams",
  "homepage": "https://nexmap.xyz/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:preview": "playwright test -c playwright.preview.config.ts",
    "e2e:install": "playwright install chromium",
    "typecheck": "tsc -b --noEmit",
    "gen:readme-media": "vite-node scripts/gen-readme-media.ts",
    "docs:screenshots": "node scripts/docs-screenshots.mjs",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name=nexmap",
    "deploy:workers": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "nanoid": "^5.1.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gifenc": "^1.0.3",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.2",
    "wrangler": "^4.157.0"
  }
}
