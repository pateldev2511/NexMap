# Cloudflare headers (Pages + Workers Static Assets read this file).
# The Content-Security-Policy is injected as a <meta> at build time (single source
# of truth in src/lib/csp.ts), so it is NOT duplicated here. These add the headers a
# meta tag can't set, plus sensible caching.

# Hashed build assets are immutable — cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# App shell and service worker must always revalidate so updates roll out.
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Security headers for every response (frame-ancestors can't be set via meta CSP).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=()
